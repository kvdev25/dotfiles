#! /usr/bin/env bash

if [[ -z "$PICKER_OPENED" ]]; then
  export PICKER_OPENED=1
  xdg-terminal-exec "$0" "$@"
fi

source="pacman"
action="install"

for arg in "$@"; do
  case "$arg" in
  -aur) source="yay" ;;
  -S) action="install" ;;
  -R) action="remove" ;;
  *)
    echo "Specify '-S' to install or '-R' to remove"
    ;;
  esac
done

if [[ $action = "install" ]]; then
  if [[ $source = "yay" ]]; then
    $source -Slq |
      fzf --style=minimal --multi --preview="$source -Si {1}" |
      xargs -ro $source -S
  else
    $source -Slq |
      fzf --style=minimal --multi --preview="$source -Si {1}" |
      xargs -ro sudo $source -S
  fi

elif [[ $action == "remove" ]]; then
  pacman -Qeq |
    fzf --style=minimal --multi --preview="pacman -Qi {1}" |
    xargs -ro sudo pacman -Rns
fi
