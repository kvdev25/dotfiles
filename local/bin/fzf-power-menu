#! /usr/bin/env bash

if [[ -z "$PICKER_OPENED" ]]; then
  export PICKER_OPENED=1
  xdg-terminal-exec "$0" "$@"
fi

modes=(
  "󰒲 Sleep"
  " Shutdown"
  " Reboot"
  "󰿅 Exit Hyprland"
  " Logout"
)

option=$(printf "%s\n" "${modes[@]}" | fzf --style=minimal)

case "$option" in
'󰒲 Sleep') systemctl suspend ;;
' Shutdown') systemctl poweroff ;;
' Reboot') systemctl reboot ;;
'󰿅 Exit Hyprland') uwsm stop ;;
' Logout') loginctl terminate-user $USER ;;
esac
