#! /usr/bin/env bash

if [[ -z "$PICKER_OPENED" ]]; then
  export PICKER_OPENED=1
  xdg-terminal-exec "$0" "$@"
fi

profile=$(
  tuned-adm list |
    grep '^-' |
    sed 's/^- //' |
    awk -F ' - ' '{print $1 "\t" $2}' |
    fzf --style=minimal --delimiter='\t' --with-nth=1 --preview='echo {2}' |
    cut -f1
)

[[ $profile ]] || exit
notify-send "Power Profile: $profile"
tuned-adm profile $profile
