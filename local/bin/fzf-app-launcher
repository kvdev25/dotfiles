#! /usr/bin/env bash

if [[ -z "$PICKER_OPENED" ]]; then
  export PICKER_OPENED=1
  xdg-terminal-exec --app-id='term.floating' "$0" "$@"
fi

app=$(
  fd -H -e desktop . /usr/share/applications ~/.local/share/applications -0 |
    xargs -0 -n1 basename --suffix .desktop |
    fzf --style=minimal
)
[[ $app ]] || exit

setsid gtk-launch "$app" &
sleep 0
